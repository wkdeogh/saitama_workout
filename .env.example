# Optional overrides. Production public configuration is in src/cloud/firebaseConfig.js.
# For local tests only (start npm run emulators in another terminal):
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-saitama.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-saitama
VITE_FIREBASE_APP_ID=demo-app
# Shared outdoor world: use the exact Realtime Database URL from Firebase console.
# Anonymous Authentication must also be enabled for guest visitors.
# The local emulator uses its own demo database when this value is empty.
VITE_FIREBASE_DATABASE_URL=

# Ads: local development defaults to preview; production defaults to connect.
# Copy only these ad variables for production, not the emulator values above.
# off | preview | connect (shared SDK / Auto ads) | adsense (manual card)
VITE_ADS_MODE=connect
# Publisher is shared by connect/adsense; slot is required only for manual cards.
VITE_ADSENSE_CLIENT=ca-pub-6094417231997652
VITE_ADSENSE_SLOT=
