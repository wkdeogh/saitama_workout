rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.firebase.sign_in_provider == 'custom' && request.auth.token.kakao == true)
      );
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function whole(value, max) { return value is int && value >= 0 && value <= max; }
    function day(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    match /accounts/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['payload','participating','updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 850000
        && request.resource.data.participating is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /rankings/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow delete: if owner(uid);
      allow create, update: if owner(uid)
        && getAfter(/databases/$(database)/documents/accounts/$(uid)).data.participating == true
        && request.resource.data.keys().hasOnly(['characterName','totalExp','weeklyExp','weekStart','level','calculatedOn','lastWorkout','totals','updatedAt'])
        && request.resource.data.characterName is string
        && request.resource.data.characterName.size() >= 1 && request.resource.data.characterName.size() <= 20
        && whole(request.resource.data.totalExp,1600000000)
        && whole(request.resource.data.weeklyExp,280000)
        && request.resource.data.weeklyExp <= request.resource.data.totalExp
        && whole(request.resource.data.level,1000) && request.resource.data.level >= 1
        && day(request.resource.data.weekStart) && day(request.resource.data.calculatedOn) && day(request.resource.data.lastWorkout)
        && request.resource.data.lastWorkout <= request.resource.data.calculatedOn
        && request.resource.data.weekStart <= request.resource.data.calculatedOn
        && request.resource.data.totals.keys().hasOnly(['pushups','squats','situps','runningKm'])
        && whole(request.resource.data.totals.pushups,400000000)
        && whole(request.resource.data.totals.squats,400000000)
        && whole(request.resource.data.totals.situps,400000000)
        && request.resource.data.totals.runningKm is number
        && request.resource.data.totals.runningKm >= 0 && request.resource.data.totals.runningKm <= 40000000
        && request.resource.data.totalExp == request.resource.data.totals.pushups + request.resource.data.totals.squats + request.resource.data.totals.situps + int(request.resource.data.totals.runningKm * 10 + 0.5)
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
