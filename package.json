{
  "name": "saitama-training",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "test:rules": "firebase emulators:exec --project demo-saitama --only firestore 'node --test tests/firebase/rules.test.js'",
    "emulators": "firebase emulators:start --project demo-saitama --only auth,firestore"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
